{
  "name": "sag",
  "version": "0.2.1",
  "description": "Smart Access Gateway - a stateless, deployable identity proxy (RESOAuth Ltd)",
  "homepage": "https://sag.resoauth.dev",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./cloudflare": "./adapters/cloudflare/worker.js",
    "./lambda": "./adapters/lambda/handler.js"
  },
  "scripts": {
    "check": "find src adapters tools examples test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "dev": "node adapters/node/server.js",
    "start": "node adapters/node/server.js",
    "start:persistent": "node tools/bootstrap.js",
    "lint": "eslint . --max-warnings 0",
    "sast": "eslint src adapters tools --max-warnings 0",
    "fuzz": "jazzer test/fuzz/sag.fuzz.js --timeout=5000 -- -runs=10000 -max_len=4096",
    "fuzz:release": "jazzer test/fuzz/sag.fuzz.js --timeout=5000 -- -runs=100000 -max_len=4096",
    "test": "npm run test:coverage && npm run coverage:badge",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "test:plain": "node --test test/*.test.js",
    "coverage:badge": "node tools/coverage-badge.js",
    "keygen": "node tools/keygen.js",
    "hash-secret": "node tools/hash-secret.js",
    "generate-client-secret": "node tools/generate-client-secret.js",
    "cf:dev": "wrangler dev --config adapters/cloudflare/wrangler.toml",
    "cf:deploy": "wrangler deploy --config adapters/cloudflare/wrangler.toml",
    "example": "node examples/relying-party/server.js",
    "stack": "test/local-stack/stack.sh",
    "stack:up": "test/local-stack/stack.sh up",
    "stack:verify": "test/local-stack/stack.sh verify",
    "stack:down": "test/local-stack/stack.sh down"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@jazzer.js/core": "^4.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true
  }
}
