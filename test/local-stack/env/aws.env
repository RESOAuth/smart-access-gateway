# Where AWS is, for the instances that use it.
#
# LocalStack serves every service it emulates on one port, so all three
# endpoints below are the same URL and a single AWS_ENDPOINT_URL would do. They
# are written out one by one because that is the shape a real local stack takes:
# MinIO for S3, DynamoDB Local for the table, something else again for KMS. SAG
# reads the AWS SDK's own variable names, so an environment already set up for
# an emulator works unchanged.
#
# Every container shares the host's network, so this is the same address
# LocalStack is reachable at from a terminal.
AWS_ENDPOINT_URL_KMS=http://localhost:4566
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:4566
AWS_ENDPOINT_URL_S3=http://localhost:4566

# LocalStack accepts any credentials and conventionally uses these. They are
# checked for shape, not for secrecy, so a signed request that is missing a
# header still fails.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-2
