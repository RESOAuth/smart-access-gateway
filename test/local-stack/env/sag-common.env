# Settings every SAG instance in the stack shares.
#
# Read by docker compose on the host and handed to the container, so an edit
# here needs a restart of the instance rather than a rebuild:
#
#   ./stack.sh restart sag-node
#
# The Workers instance does not read this file. A Worker's environment comes
# from its wrangler configuration rather than from the process, so its
# equivalents live in workers/wrangler.dev.toml.

# Codes are printed to the instance's log, and shown on the page as well,
# because every issuer here is a development hostname. That is what makes the
# stack usable without a mail server; see src/email/console.js.
EMAIL_PROVIDER=console

# Every request logged with its status and how long it took. This is a stack for
# watching things happen.
LOG_LEVEL=debug

# One session across all relying parties on an instance, which is what makes
# the second sign-in silent and prompt=none worth trying.
SESSION_SCOPE=shared

# Higher than the defaults of 2 per ten minutes and 5 a day, because a stack
# gets poked at repeatedly by the same address and being locked out of your own
# test rig teaches nobody anything. Production wants the defaults.
OTP_SEND_BURST=20
OTP_SEND_DAILY_LIMIT=200

UI_ORG_NAME=SAG local stack

# Each relying party on an instance gets its own `sub`, rather than the shared
# one that is the default. The three instances each have their own salt as
# well, which is why the same address is a different person on each of them -
# see docs/adr/0011-subject-derived-from-the-verified-address.md.
SUBJECT_TYPE=pairwise

# Guess a display name from the address and draw an initials avatar, so the
# "continue signing in" screen shows what a federated deployment would show
# without needing a real Microsoft or Google registration to see it. Both are
# off by default; see docs/profile-claims.md for why.
PROFILE_NAME_FROM_EMAIL=infer
PROFILE_AVATAR_FALLBACK=initials

# No upstream providers are configured here, so there is never an ambiguity to
# resolve and no lookup would happen anyway. Set off explicitly so that a stack
# on a machine with no DNS behaves identically to one with.
SIGNIN_PROVIDER_HINT=off
